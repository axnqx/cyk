/*
 * CYK parser with CFG -> CNF conversion.
 *
 * Input: a text file (the filename may end in .c) containing a grammar and
 *        an input string. The CYK report is written back into that same file.
 *
 * Example input file:
 *   START: S
 *   S -> A B | b
 *   A -> a
 *   B -> b
 *   INPUT: ab
 *
 * Grammar notation:
 *   - Each production is written as: Nonterminal -> alternative | alternative
 *   - Separate multi-character symbols with spaces: Expr -> Expr PLUS Term
 *   - Compact RHS notation is supported for single-character symbols: S -> ABa
 *   - A symbol in a RHS is a nonterminal if it appears on a production's LHS;
 *     otherwise it is treated as a terminal.
 *   - Quote multi-character terminals: A -> 'id' or INPUT: 'id' '+' 'id'
 *   - Epsilon may be written as epsilon, eps, ε, ~, #, or an empty RHS.
 *   - INPUT may also be written as STRING or WORD.
 *
 * Build:
 *   clang -std=c11 -Wall -Wextra -pedantic cyk.c -o cyk
 * Run:
 *   ./cyk grammar.c
 *
 * The program replaces any previous section beginning with
 * "=== CYK OUTPUT ===" and writes a fresh report after the input text.
 */

#include <ctype.h>
#include <stdarg.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX_FILE_BYTES (2u * 1024u * 1024u)
#define MAX_LINE_LEN 8192
#define MAX_SYMBOL_LEN 32
#define MAX_NONTERMINALS 256
#define MAX_RULES 1024
#define MAX_RHS 32
#define MAX_INPUT_TOKENS 256
#define MAX_NULLABLES_PER_RULE 16

#define OUTPUT_MARKER "=== CYK OUTPUT ==="

typedef struct {
    char lhs[MAX_SYMBOL_LEN];
    int rhs_len;
    char rhs[MAX_RHS][MAX_SYMBOL_LEN];
} Rule;

typedef struct {
    char start[MAX_SYMBOL_LEN];
    char nonterminals[MAX_NONTERMINALS][MAX_SYMBOL_LEN];
    int nonterminal_count;
    Rule rules[MAX_RULES];
    int rule_count;
    unsigned int fresh_counter;
} Grammar;

typedef struct {
    char tokens[MAX_INPUT_TOKENS][MAX_SYMBOL_LEN];
    int count;
} TokenList;

static void set_error(char *dst, size_t dst_size, const char *fmt, ...) {
    va_list args;
    va_start(args, fmt);
    (void)vsnprintf(dst, dst_size, fmt, args);
    va_end(args);
}

static void log_message(FILE *out, const char *fmt, ...) {
    va_list args;
    va_start(args, fmt);
    (void)vfprintf(out, fmt, args);
    va_end(args);
}

static char *trim(char *s) {
    char *end;
    while (*s != '\0' && isspace((unsigned char)*s)) {
        ++s;
    }
    if (*s == '\0') {
        return s;
    }
    end = s + strlen(s) - 1;
    while (end > s && isspace((unsigned char)*end)) {
        *end-- = '\0';
    }
    return s;
}

static int starts_with_ci(const char *text, const char *prefix) {
    while (*prefix != '\0') {
        if (*text == '\0' || tolower((unsigned char)*text) !=
                                  tolower((unsigned char)*prefix)) {
            return 0;
        }
        ++text;
        ++prefix;
    }
    return 1;
}

static int is_epsilon_token(const char *s) {
    return s[0] == '\0' || strcmp(s, "ε") == 0 ||
           strcmp(s, "epsilon") == 0 || strcmp(s, "EPSILON") == 0 ||
           strcmp(s, "eps") == 0 || strcmp(s, "EPS") == 0 ||
           strcmp(s, "~") == 0 || strcmp(s, "#") == 0 ||
           strcmp(s, "lambda") == 0 || strcmp(s, "LAMBDA") == 0;
}

static int find_nonterminal(const Grammar *g, const char *name) {
    int i;
    for (i = 0; i < g->nonterminal_count; ++i) {
        if (strcmp(g->nonterminals[i], name) == 0) {
            return i;
        }
    }
    return -1;
}

static int add_nonterminal(Grammar *g, const char *name) {
    int existing = find_nonterminal(g, name);
    if (existing >= 0) {
        return existing;
    }
    if (g->nonterminal_count >= MAX_NONTERMINALS) {
        return -1;
    }
    (void)snprintf(g->nonterminals[g->nonterminal_count], MAX_SYMBOL_LEN,
                   "%s", name);
    return g->nonterminal_count++;
}

static int is_nonterminal(const Grammar *g, const char *name) {
    return find_nonterminal(g, name) >= 0;
}

static int rules_equal(const Rule *a, const Rule *b) {
    int i;
    if (strcmp(a->lhs, b->lhs) != 0 || a->rhs_len != b->rhs_len) {
        return 0;
    }
    for (i = 0; i < a->rhs_len; ++i) {
        if (strcmp(a->rhs[i], b->rhs[i]) != 0) {
            return 0;
        }
    }
    return 1;
}

static int add_rule(Grammar *g, const char *lhs,
                    const char rhs[][MAX_SYMBOL_LEN], int rhs_len) {
    Rule candidate;
    int i;
    int r;

    if (rhs_len < 0 || rhs_len > MAX_RHS) {
        return 0;
    }
    memset(&candidate, 0, sizeof(candidate));
    (void)snprintf(candidate.lhs, MAX_SYMBOL_LEN, "%s", lhs);
    candidate.rhs_len = rhs_len;
    for (i = 0; i < rhs_len; ++i) {
        (void)snprintf(candidate.rhs[i], MAX_SYMBOL_LEN, "%s", rhs[i]);
    }

    for (r = 0; r < g->rule_count; ++r) {
        if (rules_equal(&g->rules[r], &candidate)) {
            return 1;
        }
    }
    if (g->rule_count >= MAX_RULES) {
        return 0;
    }
    g->rules[g->rule_count++] = candidate;
    return 1;
}

static int add_rule_from_rule(Grammar *g, const char *lhs, const Rule *src) {
    return add_rule(g, lhs, src->rhs, src->rhs_len);
}

static int add_fresh_nonterminal(Grammar *g, char out[MAX_SYMBOL_LEN]) {
    char candidate[MAX_SYMBOL_LEN];
    do {
        ++g->fresh_counter;
        (void)snprintf(candidate, sizeof(candidate), "CNF_%u", g->fresh_counter);
    } while (is_nonterminal(g, candidate));

    if (add_nonterminal(g, candidate) < 0) {
        return 0;
    }
    (void)snprintf(out, MAX_SYMBOL_LEN, "%s", candidate);
    return 1;
}

static int contains_whitespace(const char *s) {
    while (*s != '\0') {
        if (isspace((unsigned char)*s)) {
            return 1;
        }
        ++s;
    }
    return 0;
}

/* Tokenize one RHS alternative. Without spaces, split into single characters. */
static int tokenize_symbols(const Grammar *g, char *text,
                             char out[][MAX_SYMBOL_LEN], int *count) {
    char *p;
    char *s = trim(text);
    int n = 0;
    int spaced = contains_whitespace(s);

    *count = 0;
    if (is_epsilon_token(s)) {
        return 1;
    }

    if (!spaced && is_nonterminal(g, s)) {
        (void)snprintf(out[0], MAX_SYMBOL_LEN, "%s", s);
        *count = 1;
        return 1;
    }

    if (!spaced && (s[0] == '\'' || s[0] == '"')) {
        size_t len = strlen(s);
        if (len < 2 || s[len - 1] != s[0] || len - 2 >= MAX_SYMBOL_LEN) {
            return 0;
        }
        memcpy(out[0], s + 1, len - 2);
        out[0][len - 2] = '\0';
        *count = 1;
        return out[0][0] != '\0';
    }

    if (!spaced) {
        size_t i;
        size_t len = strlen(s);
        if (len > MAX_RHS) {
            return 0;
        }
        for (i = 0; i < len; ++i) {
            if (n >= MAX_RHS) {
                return 0;
            }
            out[n][0] = s[i];
            out[n][1] = '\0';
            ++n;
        }
        *count = n;
        return 1;
    }

    p = s;
    while (*p != '\0') {
        char quote = '\0';
        char token[MAX_SYMBOL_LEN];
        size_t used = 0;

        while (*p != '\0' && isspace((unsigned char)*p)) {
            ++p;
        }
        if (*p == '\0') {
            break;
        }
        if (*p == '\'' || *p == '"') {
            quote = *p++;
            while (*p != '\0' && *p != quote) {
                if (used + 1 >= sizeof(token)) {
                    return 0;
                }
                token[used++] = *p++;
            }
            if (*p != quote) {
                return 0;
            }
            ++p;
        } else {
            while (*p != '\0' && !isspace((unsigned char)*p)) {
                if (used + 1 >= sizeof(token)) {
                    return 0;
                }
                token[used++] = *p++;
            }
        }
        token[used] = '\0';
        if (used == 0 || n >= MAX_RHS) {
            return 0;
        }
        (void)snprintf(out[n], MAX_SYMBOL_LEN, "%s", token);
        ++n;
    }

    if (n == 1 && is_epsilon_token(out[0])) {
        *count = 0;
        return 1;
    }
    *count = n;
    return 1;
}

static int parse_rhs_alternatives(Grammar *g, const char *lhs, char *rhs_text,
                                  char *error, size_t error_size) {
    char *start = rhs_text;
    char quote = '\0';
    char *p;

    for (p = rhs_text;; ++p) {
        if (*p == '\'' || *p == '"') {
            if (quote == '\0') {
                quote = *p;
            } else if (quote == *p) {
                quote = '\0';
            }
        }
        if ((*p == '|' && quote == '\0') || *p == '\0') {
            char saved = *p;
            char alternative[MAX_LINE_LEN];
            char symbols[MAX_RHS][MAX_SYMBOL_LEN];
            int symbol_count = 0;
            (void)snprintf(alternative, sizeof(alternative), "%.*s",
                           (int)(p - start), start);
            if (!tokenize_symbols(g, alternative, symbols, &symbol_count)) {
                set_error(error, error_size,
                          "Could not tokenize the RHS alternative for %s. Check quotes or symbol lengths.",
                          lhs);
                return 0;
            }
            if (!add_rule(g, lhs, symbols, symbol_count)) {
                set_error(error, error_size,
                          "Grammar exceeds the configured rule limit (%d).", MAX_RULES);
                return 0;
            }
            if (saved == '\0') {
                break;
            }
            start = p + 1;
        }
        if (*p == '\0') {
            break;
        }
    }
    return 1;
}

static int parse_source(const char *source, Grammar *g, char input_text[MAX_LINE_LEN],
                        int *has_input, char *error, size_t error_size) {
    const char *cursor = source;
    int first_lhs_seen = 0;

    *has_input = 0;
    input_text[0] = '\0';

    /* Predeclare every LHS so a multi-character nonterminal may be used
       before its own production appears (for example, S -> Expr). */
    {
        const char *pre = source;
        while (*pre != '\0') {
            char line[MAX_LINE_LEN];
            size_t len = 0;
            char *work;
            char *arrow;
            while (pre[len] != '\0' && pre[len] != '\n') ++len;
            if (len >= sizeof(line)) break;
            memcpy(line, pre, len);
            line[len] = '\0';
            pre += len;
            if (*pre == '\n') ++pre;
            work = trim(line);
            if (*work == '\0' || starts_with_ci(work, "//")) continue;
            arrow = strstr(work, "->");
            if (arrow != NULL) {
                char *lhs;
                *arrow = '\0';
                lhs = trim(work);
                if (*lhs != '\0' && strlen(lhs) < MAX_SYMBOL_LEN &&
                    strchr(lhs, ' ') == NULL && strchr(lhs, '\t') == NULL) {
                    (void)add_nonterminal(g, lhs);
                }
            }
        }
    }

    while (*cursor != '\0') {
        char line[MAX_LINE_LEN];
        size_t len = 0;
        char *work;
        char *arrow;

        while (cursor[len] != '\0' && cursor[len] != '\n') {
            ++len;
        }
        if (len >= sizeof(line)) {
            set_error(error, error_size, "A line in the input file is too long.");
            return 0;
        }
        memcpy(line, cursor, len);
        line[len] = '\0';
        cursor += len;
        if (*cursor == '\n') {
            ++cursor;
        }
        if (len > 0 && line[len - 1] == '\r') {
            line[len - 1] = '\0';
        }

        /* Remove a simple // comment, preserving quoted terminal text. */
        {
            char q = '\0';
            size_t i;
            for (i = 0; line[i] != '\0'; ++i) {
                if (line[i] == '\'' || line[i] == '"') {
                    if (q == '\0') q = line[i];
                    else if (q == line[i]) q = '\0';
                } else if (line[i] == '/' && line[i + 1] == '/' && q == '\0') {
                    line[i] = '\0';
                    break;
                }
            }
        }

        work = trim(line);
        if (*work == '\0' || starts_with_ci(work, "//")) {
            continue;
        }
        if (starts_with_ci(work, "START:")) {
            char *value = trim(work + 6);
            if (*value == '\0' || strlen(value) >= MAX_SYMBOL_LEN) {
                set_error(error, error_size, "Invalid START declaration.");
                return 0;
            }
            (void)snprintf(g->start, sizeof(g->start), "%s", value);
            continue;
        }
        if (starts_with_ci(work, "INPUT:") || starts_with_ci(work, "STRING:") ||
            starts_with_ci(work, "WORD:")) {
            char *colon = strchr(work, ':');
            char *value = trim(colon + 1);
            if (strlen(value) >= MAX_LINE_LEN) {
                set_error(error, error_size, "The input string is too long.");
                return 0;
            }
            (void)snprintf(input_text, MAX_LINE_LEN, "%s", value);
            *has_input = 1;
            continue;
        }

        arrow = strstr(work, "->");
        if (arrow != NULL) {
            char lhs[MAX_SYMBOL_LEN];
            char *lhs_end;
            char *rhs;
            size_t lhs_len;

            *arrow = '\0';
            lhs_end = trim(work);
            lhs_len = strlen(lhs_end);
            if (lhs_len == 0 || lhs_len >= sizeof(lhs)) {
                set_error(error, error_size, "Invalid or excessively long production LHS.");
                return 0;
            }
            (void)snprintf(lhs, sizeof(lhs), "%s", lhs_end);
            if (strchr(lhs, ' ') != NULL || strchr(lhs, '\t') != NULL) {
                set_error(error, error_size,
                          "A nonterminal name must be one token (no spaces): %s", lhs);
                return 0;
            }
            if (add_nonterminal(g, lhs) < 0) {
                set_error(error, error_size,
                          "Grammar exceeds the configured nonterminal limit (%d).",
                          MAX_NONTERMINALS);
                return 0;
            }
            if (!first_lhs_seen) {
                if (g->start[0] == '\0') {
                    (void)snprintf(g->start, sizeof(g->start), "%s", lhs);
                }
                first_lhs_seen = 1;
            }
            rhs = arrow + 2;
            if (!parse_rhs_alternatives(g, lhs, rhs, error, error_size)) {
                return 0;
            }
            continue;
        }

        /* Ignore common heading/comment lines; report other unexpected lines. */
        if (work[0] == ';' || work[0] == '%') {
            continue;
        }
        set_error(error, error_size,
                  "Unrecognized line: '%s'. Use START:, production rules, or INPUT:.", work);
        return 0;
    }

    if (g->rule_count == 0 || g->nonterminal_count == 0) {
        set_error(error, error_size, "No grammar productions were found in the input file.");
        return 0;
    }
    if (g->start[0] == '\0' || !is_nonterminal(g, g->start)) {
        set_error(error, error_size,
                  "The start symbol is missing or is not defined on a production LHS.");
        return 0;
    }
    if (!*has_input) {
        set_error(error, error_size,
                  "No input string was found. Add a line such as INPUT: ab.");
        return 0;
    }
    return 1;
}

static int parse_input_tokens(char *input_text, TokenList *tokens,
                              char *error, size_t error_size) {
    char *s = trim(input_text);
    int n = 0;

    tokens->count = 0;
    if (is_epsilon_token(s)) {
        return 1;
    }

    if (!contains_whitespace(s) && (s[0] == '\'' || s[0] == '"')) {
        char quote = s[0];
        size_t len = strlen(s);
        if (len < 2 || s[len - 1] != quote || len - 2 >= MAX_SYMBOL_LEN) {
            set_error(error, error_size, "Invalid quoted input token.");
            return 0;
        }
        memcpy(tokens->tokens[0], s + 1, len - 2);
        tokens->tokens[0][len - 2] = '\0';
        if (tokens->tokens[0][0] == '\0') {
            return 1;
        }
        tokens->count = 1;
        return 1;
    }

    if (!contains_whitespace(s)) {
        size_t i;
        size_t len = strlen(s);
        if (len > MAX_INPUT_TOKENS) {
            set_error(error, error_size, "Input has more than %d characters/tokens.",
                      MAX_INPUT_TOKENS);
            return 0;
        }
        for (i = 0; i < len; ++i) {
            tokens->tokens[n][0] = s[i];
            tokens->tokens[n][1] = '\0';
            ++n;
        }
        tokens->count = n;
        return 1;
    }

    while (*s != '\0') {
        char token[MAX_SYMBOL_LEN];
        size_t used = 0;
        char quote = '\0';

        while (*s != '\0' && isspace((unsigned char)*s)) ++s;
        if (*s == '\0') break;
        if (*s == '\'' || *s == '"') {
            quote = *s++;
            while (*s != '\0' && *s != quote) {
                if (used + 1 >= sizeof(token)) {
                    set_error(error, error_size, "An input token is too long.");
                    return 0;
                }
                token[used++] = *s++;
            }
            if (*s != quote) {
                set_error(error, error_size, "Unclosed quote in INPUT declaration.");
                return 0;
            }
            ++s;
        } else {
            while (*s != '\0' && !isspace((unsigned char)*s)) {
                if (used + 1 >= sizeof(token)) {
                    set_error(error, error_size, "An input token is too long.");
                    return 0;
                }
                token[used++] = *s++;
            }
        }
        token[used] = '\0';
        if (used == 0 || n >= MAX_INPUT_TOKENS) {
            set_error(error, error_size, "Input has too many or empty tokens.");
            return 0;
        }
        if (is_epsilon_token(token)) {
            if (n != 0) {
                set_error(error, error_size,
                          "Epsilon must be the entire input string, not one token among others.");
                return 0;
            }
            tokens->count = 0;
            return 1;
        }
        (void)snprintf(tokens->tokens[n], MAX_SYMBOL_LEN, "%s", token);
        ++n;
    }
    tokens->count = n;
    return 1;
}

static void print_grammar(FILE *out, const Grammar *g, const char *heading) {
    int i;
    log_message(out, "\n%s\n", heading);
    log_message(out, "Start symbol: %s\n", g->start);
    if (g->rule_count == 0) {
        log_message(out, "  [no productions]\n");
        return;
    }
    for (i = 0; i < g->rule_count; ++i) {
        int j;
        log_message(out, "  %s -> ", g->rules[i].lhs);
        if (g->rules[i].rhs_len == 0) {
            log_message(out, "ε");
        } else {
            for (j = 0; j < g->rules[i].rhs_len; ++j) {
                if (j > 0) log_message(out, " ");
                log_message(out, "%s", g->rules[i].rhs[j]);
            }
        }
        log_message(out, "\n");
    }
}

static int is_unit_rule(const Grammar *g, const Rule *r) {
    return r->rhs_len == 1 && is_nonterminal(g, r->rhs[0]);
}

static int grammar_is_cnf(const Grammar *g, char *reason, size_t reason_size) {
    int i;
    int start_on_rhs = 0;
    int has_epsilon = 0;

    for (i = 0; i < g->rule_count; ++i) {
        int j;
        const Rule *r = &g->rules[i];
        if (r->rhs_len == 0) {
            has_epsilon = 1;
            if (strcmp(r->lhs, g->start) != 0) {
                set_error(reason, reason_size,
                          "Epsilon production %s -> ε is not allowed for a non-start symbol.",
                          r->lhs);
                return 0;
            }
        }
        for (j = 0; j < r->rhs_len; ++j) {
            if (strcmp(r->rhs[j], g->start) == 0) start_on_rhs = 1;
        }
    }

    if (has_epsilon && start_on_rhs) {
        set_error(reason, reason_size,
                  "The start symbol occurs on a RHS while the grammar has an epsilon production.");
        return 0;
    }

    for (i = 0; i < g->rule_count; ++i) {
        const Rule *r = &g->rules[i];
        if (r->rhs_len == 1) {
            if (is_nonterminal(g, r->rhs[0])) {
                set_error(reason, reason_size,
                          "Unit production %s -> %s is not in CNF.", r->lhs, r->rhs[0]);
                return 0;
            }
        } else if (r->rhs_len == 2) {
            if (!is_nonterminal(g, r->rhs[0]) || !is_nonterminal(g, r->rhs[1])) {
                set_error(reason, reason_size,
                          "A length-2 RHS in %s -> ... must contain two nonterminals.",
                          r->lhs);
                return 0;
            }
        } else if (r->rhs_len != 0) {
            set_error(reason, reason_size,
                      "Production %s has %d RHS symbols; CNF allows 1 terminal or 2 nonterminals.",
                      r->lhs, r->rhs_len);
            return 0;
        }
    }

    if (reason_size > 0) reason[0] = '\0';
    return 1;
}

static int eliminate_epsilon(Grammar *g, FILE *out) {
    int nullable[MAX_NONTERMINALS] = {0};
    int changed = 1;
    int i;
    Grammar result;

    while (changed) {
        changed = 0;
        for (i = 0; i < g->rule_count; ++i) {
            const Rule *r = &g->rules[i];
            int lhs_idx = find_nonterminal(g, r->lhs);
            int all_nullable = 1;
            int j;
            if (lhs_idx < 0 || nullable[lhs_idx]) continue;
            if (r->rhs_len == 0) {
                nullable[lhs_idx] = 1;
                changed = 1;
                continue;
            }
            for (j = 0; j < r->rhs_len; ++j) {
                int rhs_idx = find_nonterminal(g, r->rhs[j]);
                if (rhs_idx < 0 || !nullable[rhs_idx]) {
                    all_nullable = 0;
                    break;
                }
            }
            if (all_nullable) {
                nullable[lhs_idx] = 1;
                changed = 1;
            }
        }
    }

    log_message(out, "\n[CNF conversion step 1] Epsilon-production elimination\n");
    log_message(out, "Nullable nonterminals: ");
    {
        int any = 0;
        for (i = 0; i < g->nonterminal_count; ++i) {
            if (nullable[i]) {
                log_message(out, "%s ", g->nonterminals[i]);
                any = 1;
            }
        }
        if (!any) log_message(out, "none");
        log_message(out, "\n");
    }

    result = *g;
    result.rule_count = 0;
    for (i = 0; i < g->rule_count; ++i) {
        const Rule *r = &g->rules[i];
        int nullable_positions[MAX_RHS];
        int nullable_count = 0;
        uint64_t combinations;
        uint64_t mask;
        int j;

        if (r->rhs_len == 0) continue;
        for (j = 0; j < r->rhs_len; ++j) {
            int idx = find_nonterminal(g, r->rhs[j]);
            if (idx >= 0 && nullable[idx]) {
                nullable_positions[nullable_count++] = j;
            }
        }
        if (nullable_count > MAX_NULLABLES_PER_RULE) {
            log_message(out,
                        "Cannot safely expand %s: it has %d nullable positions (limit %d).\n",
                        r->lhs, nullable_count, MAX_NULLABLES_PER_RULE);
            return 0;
        }
        combinations = UINT64_C(1) << nullable_count;
        for (mask = 0; mask < combinations; ++mask) {
            char rhs[MAX_RHS][MAX_SYMBOL_LEN];
            int rhs_len = 0;
            int position = 0;
            for (j = 0; j < r->rhs_len; ++j) {
                int nullable_pos_index;
                int omit = 0;
                for (nullable_pos_index = 0;
                     nullable_pos_index < nullable_count; ++nullable_pos_index) {
                    if (nullable_positions[nullable_pos_index] == j &&
                        ((mask >> nullable_pos_index) & UINT64_C(1)) != 0) {
                        omit = 1;
                        break;
                    }
                }
                if (!omit) {
                    (void)snprintf(rhs[rhs_len], MAX_SYMBOL_LEN, "%s", r->rhs[j]);
                    ++rhs_len;
                } else {
                    ++position;
                }
            }
            (void)position;
            if (rhs_len == 0 && strcmp(r->lhs, g->start) != 0) {
                continue;
            }
            if (!add_rule(&result, r->lhs, rhs, rhs_len)) {
                log_message(out, "Rule limit reached during epsilon elimination.\n");
                return 0;
            }
        }
    }
    *g = result;
    print_grammar(out, g, "Grammar after epsilon elimination:");
    return 1;
}

static int eliminate_unit_productions(Grammar *g, FILE *out) {
    unsigned char reach[MAX_NONTERMINALS][MAX_NONTERMINALS] = {{0}};
    Grammar result = *g;
    int i, j, k;

    log_message(out, "\n[CNF conversion step 2] Unit-production elimination\n");
    for (i = 0; i < g->nonterminal_count; ++i) reach[i][i] = 1;
    for (i = 0; i < g->rule_count; ++i) {
        const Rule *r = &g->rules[i];
        if (is_unit_rule(g, r)) {
            int a = find_nonterminal(g, r->lhs);
            int b = find_nonterminal(g, r->rhs[0]);
            if (a >= 0 && b >= 0) reach[a][b] = 1;
        }
    }
    for (k = 0; k < g->nonterminal_count; ++k) {
        for (i = 0; i < g->nonterminal_count; ++i) {
            for (j = 0; j < g->nonterminal_count; ++j) {
                if (reach[i][k] && reach[k][j]) reach[i][j] = 1;
            }
        }
    }

    result.rule_count = 0;
    for (i = 0; i < g->nonterminal_count; ++i) {
        for (j = 0; j < g->rule_count; ++j) {
            const Rule *r = &g->rules[j];
            int source_idx;
            if (is_unit_rule(g, r)) continue;
            source_idx = find_nonterminal(g, r->lhs);
            if (source_idx >= 0 && reach[i][source_idx]) {
                if (!add_rule_from_rule(&result, g->nonterminals[i], r)) {
                    log_message(out, "Rule limit reached during unit elimination.\n");
                    return 0;
                }
            }
        }
    }
    *g = result;
    print_grammar(out, g, "Grammar after unit-production elimination:");
    return 1;
}

static int remove_useless_symbols(Grammar *g, FILE *out) {
    unsigned char generating[MAX_NONTERMINALS] = {0};
    unsigned char reachable[MAX_NONTERMINALS] = {0};
    int changed = 1;
    int i, j;
    Grammar filtered = *g;

    log_message(out, "\n[CNF conversion step 3] Useless-symbol elimination\n");
    while (changed) {
        changed = 0;
        for (i = 0; i < g->rule_count; ++i) {
            const Rule *r = &g->rules[i];
            int lhs_idx = find_nonterminal(g, r->lhs);
            int can_generate = 1;
            if (lhs_idx < 0 || generating[lhs_idx]) continue;
            for (j = 0; j < r->rhs_len; ++j) {
                int rhs_idx = find_nonterminal(g, r->rhs[j]);
                if (rhs_idx >= 0 && !generating[rhs_idx]) {
                    can_generate = 0;
                    break;
                }
            }
            if (can_generate) {
                generating[lhs_idx] = 1;
                changed = 1;
            }
        }
    }

    filtered.rule_count = 0;
    for (i = 0; i < g->rule_count; ++i) {
        const Rule *r = &g->rules[i];
        int lhs_idx = find_nonterminal(g, r->lhs);
        int keep = lhs_idx >= 0 && generating[lhs_idx];
        for (j = 0; keep && j < r->rhs_len; ++j) {
            int rhs_idx = find_nonterminal(g, r->rhs[j]);
            if (rhs_idx >= 0 && !generating[rhs_idx]) keep = 0;
        }
        if (keep && !add_rule_from_rule(&filtered, r->lhs, r)) {
            log_message(out, "Rule limit reached while removing useless symbols.\n");
            return 0;
        }
    }

    {
        int start_idx = find_nonterminal(g, g->start);
        if (start_idx >= 0 && generating[start_idx]) reachable[start_idx] = 1;
    }
    changed = 1;
    while (changed) {
        changed = 0;
        for (i = 0; i < filtered.rule_count; ++i) {
            const Rule *r = &filtered.rules[i];
            int lhs_idx = find_nonterminal(g, r->lhs);
            if (lhs_idx >= 0 && reachable[lhs_idx]) {
                for (j = 0; j < r->rhs_len; ++j) {
                    int rhs_idx = find_nonterminal(g, r->rhs[j]);
                    if (rhs_idx >= 0 && !reachable[rhs_idx]) {
                        reachable[rhs_idx] = 1;
                        changed = 1;
                    }
                }
            }
        }
    }

    g->rule_count = 0;
    for (i = 0; i < filtered.rule_count; ++i) {
        int lhs_idx = find_nonterminal(g, filtered.rules[i].lhs);
        if (lhs_idx >= 0 && reachable[lhs_idx]) {
            if (!add_rule_from_rule(g, filtered.rules[i].lhs, &filtered.rules[i])) {
                log_message(out, "Rule limit reached while removing unreachable symbols.\n");
                return 0;
            }
        }
    }

    log_message(out, "Generating nonterminals: ");
    {
        int any = 0;
        for (i = 0; i < g->nonterminal_count; ++i) {
            if (generating[i]) {
                log_message(out, "%s ", g->nonterminals[i]);
                any = 1;
            }
        }
        if (!any) log_message(out, "none");
        log_message(out, "\nReachable nonterminals: ");
        any = 0;
        for (i = 0; i < g->nonterminal_count; ++i) {
            if (reachable[i]) {
                log_message(out, "%s ", g->nonterminals[i]);
                any = 1;
            }
        }
        if (!any) log_message(out, "none");
        log_message(out, "\n");
    }
    print_grammar(out, g, "Grammar after useless-symbol elimination:");
    return 1;
}

static int isolate_terminals(Grammar *g, FILE *out) {
    char terminal_names[MAX_NONTERMINALS][MAX_SYMBOL_LEN];
    char helper_names[MAX_NONTERMINALS][MAX_SYMBOL_LEN];
    int helper_count = 0;
    Grammar result = *g;
    int i, j;

    log_message(out,
                "\n[CNF conversion step 4] Replacing terminals in long RHSs\n");
    result.rule_count = 0;
    for (i = 0; i < g->rule_count; ++i) {
        Rule copy = g->rules[i];
        if (copy.rhs_len >= 2) {
            for (j = 0; j < copy.rhs_len; ++j) {
                if (!is_nonterminal(g, copy.rhs[j])) {
                    int h;
                    for (h = 0; h < helper_count; ++h) {
                        if (strcmp(terminal_names[h], copy.rhs[j]) == 0) break;
                    }
                    if (h == helper_count) {
                        if (helper_count >= MAX_NONTERMINALS ||
                            !add_fresh_nonterminal(&result, helper_names[helper_count])) {
                            log_message(out, "Could not create a terminal helper symbol.\n");
                            return 0;
                        }
                        (void)snprintf(terminal_names[helper_count], MAX_SYMBOL_LEN,
                                       "%s", copy.rhs[j]);
                        ++helper_count;
                    }
                    (void)snprintf(copy.rhs[j], MAX_SYMBOL_LEN, "%s", helper_names[h]);
                }
            }
        }
        if (!add_rule_from_rule(&result, copy.lhs, &copy)) {
            log_message(out, "Rule limit reached while isolating terminals.\n");
            return 0;
        }
    }
    for (i = 0; i < helper_count; ++i) {
        char rhs[1][MAX_SYMBOL_LEN];
        (void)snprintf(rhs[0], MAX_SYMBOL_LEN, "%s", terminal_names[i]);
        if (!add_rule(&result, helper_names[i], rhs, 1)) {
            log_message(out, "Rule limit reached while adding terminal helpers.\n");
            return 0;
        }
    }
    *g = result;
    print_grammar(out, g, "Grammar after terminal isolation:");
    return 1;
}

static int binarize_rules(Grammar *g, FILE *out) {
    Grammar result = *g;
    int i;

    log_message(out, "\n[CNF conversion step 5] Binarizing long productions\n");
    result.rule_count = 0;
    for (i = 0; i < g->rule_count; ++i) {
        const Rule *r = &g->rules[i];
        if (r->rhs_len <= 2) {
            if (!add_rule_from_rule(&result, r->lhs, r)) {
                log_message(out, "Rule limit reached during binarization.\n");
                return 0;
            }
        } else {
            char current_lhs[MAX_SYMBOL_LEN];
            int pos;
            (void)snprintf(current_lhs, sizeof(current_lhs), "%s", r->lhs);
            for (pos = 0; pos < r->rhs_len - 2; ++pos) {
                char helper[MAX_SYMBOL_LEN];
                char rhs[2][MAX_SYMBOL_LEN];
                if (!add_fresh_nonterminal(&result, helper)) {
                    log_message(out, "Could not create a binarization helper symbol.\n");
                    return 0;
                }
                (void)snprintf(rhs[0], MAX_SYMBOL_LEN, "%s", r->rhs[pos]);
                (void)snprintf(rhs[1], MAX_SYMBOL_LEN, "%s", helper);
                if (!add_rule(&result, current_lhs, rhs, 2)) {
                    log_message(out, "Rule limit reached during binarization.\n");
                    return 0;
                }
                (void)snprintf(current_lhs, sizeof(current_lhs), "%s", helper);
            }
            {
                char rhs[2][MAX_SYMBOL_LEN];
                (void)snprintf(rhs[0], MAX_SYMBOL_LEN, "%s", r->rhs[r->rhs_len - 2]);
                (void)snprintf(rhs[1], MAX_SYMBOL_LEN, "%s", r->rhs[r->rhs_len - 1]);
                if (!add_rule(&result, current_lhs, rhs, 2)) {
                    log_message(out, "Rule limit reached during binarization.\n");
                    return 0;
                }
            }
        }
    }
    *g = result;
    print_grammar(out, g, "Grammar after binarization:");
    return 1;
}

static int convert_to_cnf(Grammar *g, FILE *out) {
    char old_start[MAX_SYMBOL_LEN];
    char new_start[MAX_SYMBOL_LEN];
    char rhs[1][MAX_SYMBOL_LEN];

    log_message(out, "\n========== CFG TO CNF CONVERSION ==========\n");
    (void)snprintf(old_start, sizeof(old_start), "%s", g->start);
    if (!add_fresh_nonterminal(g, new_start)) {
        log_message(out, "Unable to create a new start symbol.\n");
        return 0;
    }
    (void)snprintf(rhs[0], MAX_SYMBOL_LEN, "%s", old_start);
    if (!add_rule(g, new_start, rhs, 1)) {
        log_message(out, "Unable to add the new start production.\n");
        return 0;
    }
    (void)snprintf(g->start, sizeof(g->start), "%s", new_start);
    log_message(out, "Added a fresh start symbol: %s -> %s\n", new_start, old_start);

    if (!eliminate_epsilon(g, out)) return 0;
    if (!eliminate_unit_productions(g, out)) return 0;
    if (!remove_useless_symbols(g, out)) return 0;
    if (!isolate_terminals(g, out)) return 0;
    if (!binarize_rules(g, out)) return 0;

    log_message(out, "\nCNF conversion completed.\n");
    return 1;
}

static int cell_has(const unsigned char *dp, int i, int j, int nt_index) {
    size_t offset = ((size_t)i * MAX_INPUT_TOKENS + (size_t)j) *
                    MAX_NONTERMINALS + (size_t)nt_index;
    return dp[offset] != 0;
}

static void cell_add(unsigned char *dp, int i, int j, int nt_index) {
    size_t offset = ((size_t)i * MAX_INPUT_TOKENS + (size_t)j) *
                    MAX_NONTERMINALS + (size_t)nt_index;
    dp[offset] = 1;
}

static void print_cell(FILE *out, const Grammar *g, const unsigned char *dp,
                       int i, int j) {
    int nt;
    int any = 0;
    log_message(out, "{");
    for (nt = 0; nt < g->nonterminal_count; ++nt) {
        if (cell_has(dp, i, j, nt)) {
            if (any) log_message(out, ", ");
            log_message(out, "%s", g->nonterminals[nt]);
            any = 1;
        }
    }
    if (!any) log_message(out, "∅");
    log_message(out, "}");
}

static void print_dp_table(FILE *out, const Grammar *g, const unsigned char *dp,
                           int n, int completed_length) {
    int i, j;
    log_message(out, "\nCYK table after processing substring length %d:\n",
                completed_length);
    log_message(out, "Rows are start positions i; columns are end positions j.\n");
    for (i = 0; i < n; ++i) {
        log_message(out, "  i=%d: ", i + 1);
        for (j = 0; j < n; ++j) {
            if (j < i) {
                log_message(out, "    -    ");
            } else {
                char label[32];
                (void)snprintf(label, sizeof(label), "[%d,%d]", i + 1, j + 1);
                log_message(out, "%s=", label);
                print_cell(out, g, dp, i, j);
                log_message(out, " ");
            }
        }
        log_message(out, "\n");
    }
}

static int run_cyk(const Grammar *g, const TokenList *input, FILE *out) {
    unsigned char *dp;
    int n = input->count;
    int i, j, k, r;
    int start_idx = find_nonterminal(g, g->start);
    int accepted = 0;

    log_message(out, "\n========== CYK ALGORITHM ==========\n");
    log_message(out, "Input token count (n): %d\n", n);
    log_message(out, "Input tokens: ");
    if (n == 0) log_message(out, "ε (empty string)");
    for (i = 0; i < n; ++i) {
        log_message(out, "[%s] ", input->tokens[i]);
    }
    log_message(out, "\nStart symbol: %s\n", g->start);

    if (n == 0) {
        for (r = 0; r < g->rule_count; ++r) {
            if (strcmp(g->rules[r].lhs, g->start) == 0 &&
                g->rules[r].rhs_len == 0) {
                accepted = 1;
                break;
            }
        }
        log_message(out, "\nEmpty-string check: ");
        if (accepted) {
            log_message(out, "production %s -> ε exists; ACCEPT.\n", g->start);
        } else {
            log_message(out, "no production %s -> ε; REJECT.\n", g->start);
        }
        return accepted;
    }

    if (n > MAX_INPUT_TOKENS) {
        log_message(out, "Input exceeds the maximum supported token count (%d).\n",
                    MAX_INPUT_TOKENS);
        return 0;
    }
    dp = (unsigned char *)calloc((size_t)MAX_INPUT_TOKENS * MAX_INPUT_TOKENS *
                                 MAX_NONTERMINALS, sizeof(unsigned char));
    if (dp == NULL) {
        log_message(out, "Unable to allocate memory for the CYK dynamic-programming table.\n");
        return 0;
    }

    log_message(out, "\nStep 1: Initialize the diagonal cells using A -> a rules.\n");
    for (i = 0; i < n; ++i) {
        log_message(out, "Position %d, terminal '%s':\n", i + 1, input->tokens[i]);
        for (r = 0; r < g->rule_count; ++r) {
            const Rule *rule = &g->rules[r];
            if (rule->rhs_len == 1 && !is_nonterminal(g, rule->rhs[0])) {
                if (strcmp(rule->rhs[0], input->tokens[i]) == 0) {
                    int lhs_idx = find_nonterminal(g, rule->lhs);
                    if (lhs_idx >= 0) {
                        cell_add(dp, i, i, lhs_idx);
                        log_message(out, "  Match: %s -> %s; add %s to cell (%d,%d).\n",
                                    rule->lhs, rule->rhs[0], rule->lhs, i + 1, i + 1);
                    }
                }
            }
        }
        log_message(out, "  Cell (%d,%d) = ", i + 1, i + 1);
        print_cell(out, g, dp, i, i);
        log_message(out, "\n");
    }
    print_dp_table(out, g, dp, n, 1);

    log_message(out, "\nStep 2: Fill cells for substring lengths l = 2 ... n.\n");
    for (int length = 2; length <= n; ++length) {
        log_message(out, "\n--- Substring length l = %d ---\n", length);
        for (i = 0; i <= n - length; ++i) {
            j = i + length - 1;
            log_message(out, "Cell (%d,%d), substring: ", i + 1, j + 1);
            for (k = i; k <= j; ++k) {
                log_message(out, "%s", input->tokens[k]);
                if (k < j) log_message(out, " ");
            }
            log_message(out, "\n");

            for (k = i; k < j; ++k) {
                log_message(out, "  Split at k=%d: left cell (%d,%d), right cell (%d,%d).\n",
                            k + 1, i + 1, k + 1, k + 2, j + 1);
                for (r = 0; r < g->rule_count; ++r) {
                    const Rule *rule = &g->rules[r];
                    int a_idx, b_idx, c_idx;
                    int left_has, right_has;
                    if (rule->rhs_len != 2 ||
                        !is_nonterminal(g, rule->rhs[0]) ||
                        !is_nonterminal(g, rule->rhs[1])) {
                        continue;
                    }
                    a_idx = find_nonterminal(g, rule->lhs);
                    b_idx = find_nonterminal(g, rule->rhs[0]);
                    c_idx = find_nonterminal(g, rule->rhs[1]);
                    if (a_idx < 0 || b_idx < 0 || c_idx < 0) continue;
                    left_has = cell_has(dp, i, k, b_idx);
                    right_has = cell_has(dp, k + 1, j, c_idx);
                    log_message(out,
                                "    Try %s -> %s %s: left contains %s? %s; right contains %s? %s",
                                rule->lhs, rule->rhs[0], rule->rhs[1], rule->rhs[0],
                                left_has ? "YES" : "NO", rule->rhs[1],
                                right_has ? "YES" : "NO");
                    if (left_has && right_has) {
                        if (!cell_has(dp, i, j, a_idx)) {
                            cell_add(dp, i, j, a_idx);
                            log_message(out, " => MATCH; add %s to cell (%d,%d).\n",
                                        rule->lhs, i + 1, j + 1);
                        } else {
                            log_message(out, " => MATCH; %s is already in the cell.\n",
                                        rule->lhs);
                        }
                    } else {
                        log_message(out, " => no match.\n");
                    }
                }
            }
            log_message(out, "  Final cell (%d,%d) = ", i + 1, j + 1);
            print_cell(out, g, dp, i, j);
            log_message(out, "\n");
        }
        print_dp_table(out, g, dp, n, length);
    }

    log_message(out, "\nStep 3: Check whether the start symbol is in cell (1,n).\n");
    if (start_idx >= 0) {
        accepted = cell_has(dp, 0, n - 1, start_idx);
    }
    log_message(out, "Cell (1,%d) = ", n);
    print_cell(out, g, dp, 0, n - 1);
    log_message(out, "\n");
    if (accepted) {
        log_message(out, "FINAL RESULT: ACCEPTED. The input string belongs to the language.\n");
    } else {
        log_message(out, "FINAL RESULT: REJECTED. The input string does not belong to the language.\n");
    }

    free(dp);
    return accepted;
}

static char *read_file(const char *path, size_t *length_out) {
    FILE *file = fopen(path, "rb");
    long size;
    char *buffer;
    size_t got;

    if (file == NULL) return NULL;
    if (fseek(file, 0, SEEK_END) != 0) {
        fclose(file);
        return NULL;
    }
    size = ftell(file);
    if (size < 0 || (unsigned long)size > MAX_FILE_BYTES) {
        fclose(file);
        return NULL;
    }
    if (fseek(file, 0, SEEK_SET) != 0) {
        fclose(file);
        return NULL;
    }
    buffer = (char *)malloc((size_t)size + 1);
    if (buffer == NULL) {
        fclose(file);
        return NULL;
    }
    got = fread(buffer, 1, (size_t)size, file);
    fclose(file);
    if (got != (size_t)size) {
        free(buffer);
        return NULL;
    }
    buffer[got] = '\0';
    *length_out = got;
    return buffer;
}

int main(int argc, char **argv) {
    char *file_contents;
    char *source_prefix;
    size_t file_length = 0;
    size_t source_length;
    char *marker;
    Grammar grammar;
    TokenList input_tokens;
    char input_text[MAX_LINE_LEN];
    char error[512];
    int has_input = 0;
    int parsed;
    int cnf;
    int converted = 0;
    int accepted = 0;
    FILE *out;

    if (argc != 2) {
        fprintf(stderr, "Usage: %s <input-file>\n", argv[0]);
        fprintf(stderr, "Example: %s grammar.c\n", argv[0]);
        return EXIT_FAILURE;
    }

    file_contents = read_file(argv[1], &file_length);
    if (file_contents == NULL) {
        fprintf(stderr,
                "Could not read '%s'. Check that the file exists and is no larger than %u bytes.\n",
                argv[1], (unsigned int)MAX_FILE_BYTES);
        return EXIT_FAILURE;
    }

    marker = strstr(file_contents, OUTPUT_MARKER);
    source_length = marker != NULL ? (size_t)(marker - file_contents) : file_length;
    source_prefix = (char *)malloc(source_length + 1);
    if (source_prefix == NULL) {
        fprintf(stderr, "Out of memory.\n");
        free(file_contents);
        return EXIT_FAILURE;
    }
    memcpy(source_prefix, file_contents, source_length);
    source_prefix[source_length] = '\0';
    free(file_contents);

    memset(&grammar, 0, sizeof(grammar));
    error[0] = '\0';
    parsed = parse_source(source_prefix, &grammar, input_text, &has_input,
                          error, sizeof(error));
    if (parsed && !parse_input_tokens(input_text, &input_tokens, error, sizeof(error))) {
        parsed = 0;
    }

    out = fopen(argv[1], "wb");
    if (out == NULL) {
        fprintf(stderr, "Could not open '%s' for writing.\n", argv[1]);
        free(source_prefix);
        return EXIT_FAILURE;
    }

    if (source_length > 0) {
        (void)fwrite(source_prefix, 1, source_length, out);
        if (source_prefix[source_length - 1] != '\n') {
            (void)fputc('\n', out);
        }
    }
    log_message(out, "\n%s\n", OUTPUT_MARKER);
    log_message(out, "CYK parser report\n");
    log_message(out, "Input file: %s\n", argv[1]);

    if (!parsed) {
        log_message(out, "\nERROR: %s\n", error);
        log_message(out,
                    "\nExpected format:\n"
                    "START: S\n"
                    "S -> A B | b\n"
                    "A -> a\n"
                    "B -> b\n"
                    "INPUT: ab\n");
        fclose(out);
        fprintf(stderr, "Input error: %s\n", error);
        free(source_prefix);
        return EXIT_FAILURE;
    }

    print_grammar(out, &grammar, "Original grammar:");
    log_message(out, "\nInput string: %s\n",
                input_tokens.count == 0 ? "ε (empty string)" : input_text);

    {
        char reason[512];
        cnf = grammar_is_cnf(&grammar, reason, sizeof(reason));
        log_message(out, "\nCNF validation: ");
        if (cnf) {
            log_message(out, "VALID. The grammar is already in Chomsky Normal Form.\n");
        } else {
            log_message(out, "NOT VALID. %s\n", reason);
            log_message(out, "The program will convert the grammar into CNF before parsing.\n");
            converted = convert_to_cnf(&grammar, out);
            if (!converted) {
                log_message(out, "\nERROR: CNF conversion could not be completed.\n");
                fclose(out);
                fprintf(stderr, "CNF conversion failed. See the report in '%s'.\n", argv[1]);
                free(source_prefix);
                return EXIT_FAILURE;
            }
        }
    }

    print_grammar(out, &grammar, "Final grammar used by CYK (CNF):");
    {
        char reason[512];
        if (!grammar_is_cnf(&grammar, reason, sizeof(reason))) {
            log_message(out, "\nERROR: Internal CNF validation failed: %s\n", reason);
            fclose(out);
            fprintf(stderr, "Internal CNF validation failed. See '%s'.\n", argv[1]);
            free(source_prefix);
            return EXIT_FAILURE;
        }
    }
    (void)converted;

    accepted = run_cyk(&grammar, &input_tokens, out);
    log_message(out, "\n========== END OF REPORT ==========\n");
    if (fclose(out) != 0) {
        fprintf(stderr, "Warning: an error occurred while writing '%s'.\n", argv[1]);
        free(source_prefix);
        return EXIT_FAILURE;
    }

    printf("CYK report written to the same file: %s\n", argv[1]);
    printf("Result: %s\n", accepted ? "ACCEPTED" : "REJECTED");
    free(source_prefix);
    return EXIT_SUCCESS;
}










On Terminal :

Compile with
clang -std=c11 -Wall -Wextra -pedantic cyk.c -o cyk

then
./cyk grammer.c

Result
CYK report written to the same file: grammer.c
Result: ACCEPTED
